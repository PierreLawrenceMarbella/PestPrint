{
  "expo": {
    "name": "PESTPRINT",
    "slug": "pestprint-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pestprint",
    "platforms": [
      "android"
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.pestprint.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#EAF6EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow PESTPRINT to take a photo of your rice crop.",
          "photosPermission": "Allow PESTPRINT to select a rice crop image.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
